        <mxCell id="q_raw" value="&lt;b&gt;2.1.1 Raw query&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;embed (Titan) → k-NN, scoped&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f5f3;strokeColor=#0d9488;fontColor=#161d29;strokeWidth=1.6;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="q_exp" value="&lt;b&gt;2.1.2 Expanded query&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;LLM expand → embed → k-NN · parallel&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ebfd;strokeColor=#7c3aed;fontColor=#161d29;strokeWidth=1.6;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="270" y="250" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="q_uni" value="&lt;b&gt;2.2 Union&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;merge pools · dedupe&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaefff;strokeColor=#4263eb;fontColor=#161d29;strokeWidth=1.6;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="500" y="185" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="q_rr" value="&lt;b&gt;2.3 LLM reranker&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;Claude listwise → order&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2ebfd;strokeColor=#7c3aed;fontColor=#161d29;strokeWidth=1.6;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="185" width="175" height="80" as="geometry"/></mxCell>
        <mxCell id="q_ret" value="&lt;b&gt;2.4 Return to app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;results + AI-Mode stream → ai-playground&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef1f5;strokeColor=#64748b;fontColor=#161d29;strokeWidth=1.6;fontSize=12;arcSize=14;" vertex="1" parent="1"><mxGeometry x="935" y="185" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="q_os" value="&lt;b&gt;Amazon OpenSearch&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#5c6879'&gt;k-NN HNSW&lt;/span&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.opensearch_service;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="48" height="48" as="geometry"/></mxCell>
