# aosphere-core-index configuration. Copy to .env and fill in.
# Settings use the ACI_ prefix (pydantic-settings); Keycloak uses the shared
# KEYCLOAK_* names so one realm/client covers core-index and ai-playground.

# --- Source (build-time only; reads the read-only prod survey bucket) ---
# Static keys here are used by the build/extract path. They are NOT loaded for
# Bedrock (which uses the SSO profile / IRSA role) — see cli._load_dotenv.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-2

# --- Embedding backend ---
# bge   = local FastEmbed (offline, no Bedrock; default for local/dev)
# titan = Bedrock Titan Text Embeddings v2 (better cross-region recall; needs
#         Bedrock access at BUILD and QUERY time). The mounted index artifact and
#         this value must match — deployment ships the Titan index with titan.
ACI_EMBED_BACKEND=titan
# Bedrock region for Titan embeddings + AI Mode (litellm). eu-west-1 (dev1's region,
# Ireland) serves Titan + Nova/Claude(via eu.* profile) + GPT-OSS + Nemotron. We force
# this in code so it never falls back to us-east-1; override only for a region with
# full model coverage (e.g. eu-west-2 also has Qwen/GLM/DeepSeek).
ACI_BEDROCK_REGION=eu-west-1
# ACI_TITAN_WORKERS=16          # parallel Bedrock calls during a re-embed

# --- Runtime / offline container ---
# ACI_OFFLINE=1                 # serve from /data mount, no S3/docx at runtime
# ACI_DATA_DIR=/data
ACI_LOG_LEVEL=INFO              # DEBUG to trace requests + search pipeline + LiteLLM->Bedrock

# --- Extraction tab monitoring ---
# S3 mode (production): a GPU fleet publishes progress under this bucket/prefix; unset ->
# the tab shows "not configured".
# ACI_EXTRACTION_BUCKET=
# ACI_EXTRACTION_PREFIX=corpus
#
# Local filesystem mode (dev, no S3/AWS): point this at a scripts/run_corpus.py output dir
# (e.g. out/corpus) and the Extraction tab reads stage/scorecard status straight off disk
# instead. Wins over ACI_EXTRACTION_BUCKET when both are set — never inferred from the
# directory merely existing, so a deployed pod with a stray local dir does not silently
# switch modes. See service/local_extraction.py.
# ACI_LOCAL_CORPUS_DIR=out/corpus

# --- Authorization (Keycloak OIDC; mirrors ai-playground) ---
# Auth is OFF until KEYCLOAK_URL + KEYCLOAK_REALM are set (local dev stays open).
KEYCLOAK_URL=https://auth.dev1.aoslogin.net
KEYCLOAK_REALM=aosphere
# Share the playground's Keycloak client so the two apps SSO (one session). The
# client's valid redirect URIs must include this app's origin (e.g. http://localhost:8090/
# locally + the dev1/prod core-index URL).
KEYCLOAK_AUDIENCE=ai-playground-client   # token audience the API validates
KEYCLOAK_CLIENT_ID=ai-playground-client  # browser OIDC client (defaults to AUDIENCE)
# ACI_AUTH_ENABLED=1            # set 0 to force-disable even when Keycloak is configured

# --- Admin-only access (the platform is restricted to aosphere admins) ---
# ACI_REQUIRE_ADMIN=1           # set 0 to allow any authenticated user
# ACI_ADMIN_ROLE_IDS=1          # roleId(s) (custom claim) treated as admin
# ACI_ADMIN_ROLES=admin         # Keycloak realm/client role name(s) treated as admin
# ACI_ROLE_CLAIM_KEY=           # exact claim key holding {roleId} (else auto-detected)

# --- CORS (browser clients on another origin: API-docs UI, ai-playground SPA) ---
# Off by default. Set exact origins (CSV) that may call the API cross-origin.
# ACI_CORS_ALLOW_ORIGINS=http://localhost:3000,https://api-docs.dev1.aoslogin.net
# ACI_CORS_ALLOW_ORIGIN_REGEX=https://.*\.aoslogin\.net   # regex alternative
# ACI_CORS_ALLOW_CREDENTIALS=1   # 0 to disable cookies/credentialed requests
#                                # ("*" origin auto-disables credentials)

# --- Stage 4: AI table post-processing (extraction pipeline) ---
# OFF by default. The only stage that calls a paid API and the only one that can alter a
# document's text, so a host has to opt in. Gates the pass itself, not just the CLI flag,
# so a server cannot spend money on it by accident. `hybrid_extract.py --stage4-ai` runs
# regardless — asking on the command line IS the opt-in.
# ACI_STAGE4_AI_ENABLED=1
#
# WHICH model. A short alias -- haiku | sonnet (4.6) | sonnet5 -- or any Bedrock model id,
# passed through untouched, so a newly released model needs no code change. A typo is
# indistinguishable from a new id and fails at Bedrock rather than being corrected to a
# default, which would bill a run on a model nobody chose.
# ACI_STAGE4_AI_MODEL=sonnet5
#
# USD per 1M tokens for that model. Set BOTH or neither; one alone is ignored rather than
# half applied. Needed for a model this build has no price for -- otherwise its cost reads
# $0.0000 on a run that spent real money -- and useful for correcting one it has WRONG:
# sonnet5's rate is carried over from Sonnet 4.6 and unconfirmed, because the AWS pricing
# API is denied to the invoke-only role. When set, these WIN over the built-in table.
# ACI_STAGE4_AI_PRICE_IN=3
# ACI_STAGE4_AI_PRICE_OUT=15

# --- AI Mode (Bedrock via LiteLLM) ---
# ACI_AI_ENABLED=1
# ACI_LLM_MODEL=amazon.nova-lite-v1:0
# MLFLOW_TRACKING_URI=https://mlflow.dev1.aoslogin.net

# --- Spotlight entity search (/spotlight + /api/entity-search) ---
# Backend: opensearch (default, production) | atlas (MongoDB Atlas Search, legacy/fallback).
ACI_ENTITY_SEARCH_BACKEND=opensearch
# OpenSearch index alias the app queries; the sync writes a fresh <alias>-<ts> index and
# atomically repoints this alias (zero-downtime reindex).
# ACI_ENTITY_INDEX=aci-entities
# ACI_ENTITY_OS_REPLICAS=0        # >=1 in prod for HA

# OpenSearch connection (shared with the k-NN vector backend). Local Docker leaves the AWS
# vars unset -> plain HTTP. For an AWS managed domain, set ACI_OPENSEARCH_AWS_SERVICE=es
# (or aoss for Serverless) to enable SigV4/IAM signing.
# ACI_OPENSEARCH_URL=http://opensearch:9200
# ACI_OPENSEARCH_AWS_SERVICE=es
# ACI_OPENSEARCH_AWS_REGION=eu-west-1
# ACI_OPENSEARCH_AWS_PROFILE=dev1
# ACI_OPENSEARCH_TIMEOUT=60

# MongoDB Atlas — only needed when ACI_ENTITY_SEARCH_BACKEND=atlas, and for the sync's
# --backend atlas path. Secrets, so keep them in .env (not committed).
# MONGODB_URI=mongodb+srv://cluster.example.mongodb.net/
# MONGODB_USERNAME=
# MONGODB_PASSWORD=
# ATLAS_DB=aosphere_search
# ATLAS_COLLECTION=entities
# ATLAS_SEARCH_INDEX=entity_search

# --- Spotlight sync source (MSSQL -> search index; scripts/sync_atlas_search.py) ---
# MSSQL_HOST=
# MSSQL_PORT=1433
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_DATABASE=
# ACI_SYNC_ORG=101               # organisation id to scope content to, or 'all'

# --- Admin entity reindex API (POST/GET /api/admin/entity-reindex) ---
# Runs the MSSQL -> OpenSearch sync in-pod (IRSA + VPC reach RDS + the domain), so no
# developer VPN or CronJob is needed. Off by default; enable per environment. Requires the
# MSSQL_* secret above to be present on the pod.
# ACI_ADMIN_ENTITY_REINDEX=1
# ACI_ENTITY_SYNC_SCRIPT=scripts/sync_atlas_search.py   # path override (default resolves in-image)
